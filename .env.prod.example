# Reference only — ec2-bootstrap.sh generates /opt/teamboard/.env automatically
# with random secrets. This file documents what ends up there. NEVER commit a real .env.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=teamboard
POSTGRES_PASSWORD=CHANGE_ME_strong_random

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=teamboard
RABBITMQ_PASSWORD=CHANGE_ME_strong_random

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────────
MINIO_ROOT_USER=teamboard
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_random

# ── Auth service ──────────────────────────────────────────────────────────────
# AES-256 key for encrypting RSA signing keys at rest.  openssl rand -base64 32
KEY_ENCRYPTION_KEY=CHANGE_ME_base64_32

# ── Inter-service authentication ──────────────────────────────────────────────
# HS256 secret shared by all services.  openssl rand -hex 32
SERVICE_TOKEN_SECRET=CHANGE_ME_hex_32

# ── Seed script (optional) ────────────────────────────────────────────────────
SEED_ALICE_PASSWORD=AliceSecret123!
SEED_BOB_PASSWORD=BobSecret123!

# ── Deployment (supplied by CI / auto-derived — leave unset normally) ─────────
# REGISTRY (ghcr.io/<owner>) and TAG are passed by CI over SSH. PUBLIC_HOST is
# read from EC2 instance metadata. Set these only to override (e.g. non-EC2 host):
# REGISTRY=ghcr.io/<owner>
# PUBLIC_HOST=203.0.113.10
