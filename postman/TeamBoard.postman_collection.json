{
  "info": {
    "name": "TeamBoard",
    "_postman_id": "1c2bc0a0-0000-4000-8000-000000000001",
    "description": "Test collection for the TeamBoard API. Set the {{baseUrl}} variable (default http://localhost:8080). Run requests in order; tokens and IDs are captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "boardId", "value": "" },
    { "key": "columnId", "value": "" },
    { "key": "taskId", "value": "" },
    { "key": "documentId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\",\n  \"display_name\": \"Alice\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('token', data.access_token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"secret123\"\n}"
        }
      }
    },
    {
      "name": "Auth - Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "Projects - Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('projectId', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/projects/projects",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Project\",\n  \"description\": \"created via Postman\"\n}"
        }
      }
    },
    {
      "name": "Projects - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/projects/projects"
      }
    },
    {
      "name": "Projects - Create Board",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('boardId', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/projects/projects/{{projectId}}/boards",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sprint 1\",\n  \"type\": \"kanban\"\n}"
        }
      }
    },
    {
      "name": "Projects - List Columns",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data.length) pm.collectionVariables.set('columnId', data[0].id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/projects/boards/{{boardId}}/columns"
      }
    },
    {
      "name": "Tasks - Create",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('taskId', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/tasks/boards/{{boardId}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Write tests\",\n  \"column_id\": \"{{columnId}}\"\n}"
        }
      }
    },
    {
      "name": "Tasks - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/tasks/boards/{{boardId}}/tasks"
      }
    },
    {
      "name": "Tasks - Add Comment",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/tasks/tasks/{{taskId}}/comments",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"body\": \"Looks good\"\n}"
        }
      }
    },
    {
      "name": "Documents - Upload",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('documentId', pm.response.json().id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/documents/projects/{{projectId}}/documents",
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "file", "type": "file", "src": [] }
          ]
        }
      }
    },
    {
      "name": "Documents - List",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/documents/projects/{{projectId}}/documents"
      }
    },
    {
      "name": "Documents - Download",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/documents/documents/{{documentId}}/content"
      }
    },
    {
      "name": "AI - Project Summary",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/api/ai/projects/{{projectId}}/summary",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"include_comments\": true,\n  \"include_documents\": true,\n  \"focus\": \"Risiken und nächste Schritte für das Team\"\n}"
        }
      }
    }
  ]
}
