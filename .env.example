# Copy to .env before running docker compose up

# Postgres
POSTGRES_USER=teamboard
POSTGRES_PASSWORD=teamboard
POSTGRES_DB=teamboard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JWT (must be identical for all services)
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Internal service URLs (inside docker network)
AUTH_SERVICE_URL=http://auth-service:8000
PROJECTS_SERVICE_URL=http://projects-service:8000
TASKS_SERVICE_URL=http://tasks-service:8000
DOCUMENTS_SERVICE_URL=http://documents-service:8000
AI_SERVICE_URL=http://ai-service:8000

# AWS / Bedrock
# The ai-service uses the normal AWS credential provider chain.
# Locally, either set AWS_PROFILE_NAME and mount your ~/.aws folder, or set env vars in .env.
AI_PROVIDER=bedrock
AWS_REGION=eu-central-1
AWS_PROFILE_NAME=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=1200
BEDROCK_TEMPERATURE=0.2

# AWS / S3 document storage
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=teamboard/documents

# AWS / DynamoDB audit logging
AUDIT_LOG_BACKEND=none
AUDIT_DYNAMODB_TABLE=

# Gateway
GATEWAY_PORT=8080
