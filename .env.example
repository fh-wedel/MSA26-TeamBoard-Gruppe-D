# --- Core service ---
CORE_PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# Event bus selection: "redis" (local) or "eventbridge" (AWS)
EVENT_BUS=redis

# Plugin registry heartbeat TTL in seconds
PLUGIN_REGISTRY_TTL=30

# --- Persistence ---
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/poc
REDIS_URL=redis://redis:6379

# --- AWS (only required when EVENT_BUS=eventbridge) ---
AWS_REGION=eu-central-1
EVENT_BUS_NAME=msa2-bus

# --- Kanban plugin ---
KANBAN_PORT=3001
KANBAN_PLUGIN_ID=kanban-board
KANBAN_PLUGIN_VERSION=1.0.0
# Endpoint the core uses to reach the plugin (container DNS name in compose)
KANBAN_PUBLIC_ENDPOINT=http://plugin-kanban:3001
CORE_URL=http://core:3000

# --- WebSocket broadcaster (local mode) ---
BROADCASTER_PORT=3002
# DynamoDB Local endpoint used by the broadcaster
DYNAMODB_ENDPOINT=http://dynamodb-local:8000
CONNECTIONS_TABLE=ws-connections

# --- S3 / MinIO ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
