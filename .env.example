# Copy this file to .env and fill in values. Never commit .env.
# All sensitive credentials are loaded from .env by docker compose.

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=teamboard
POSTGRES_PASSWORD=change-me

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=teamboard
RABBITMQ_PASSWORD=change-me

# ── MinIO (S3-compatible storage) ─────────────────────────────────────────────
MINIO_ROOT_USER=teamboard
MINIO_ROOT_PASSWORD=change-me

# ── Auth service ──────────────────────────────────────────────────────────────
# AES-256 key for encrypting RSA signing keys at rest in the database.
# Generate: openssl rand -base64 32
KEY_ENCRYPTION_KEY=change-me

# ── Inter-service authentication ──────────────────────────────────────────────
# HS256 secret shared by all services for internal service tokens.
# Generate: openssl rand -hex 32
SERVICE_TOKEN_SECRET=change-me

# ── Seed script (make seed) ───────────────────────────────────────────────────
SEED_ALICE_PASSWORD=AliceSecret123!
SEED_BOB_PASSWORD=BobSecret123!
